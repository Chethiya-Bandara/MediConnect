# =============================================================================
# MediConnect — Environment Configuration Template
# =============================================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your actual values in .env
#   3. NEVER commit .env to GitHub — it is blocked in .gitignore
# =============================================================================


# ── Supabase Database (Chethiya) ──────────────────────────────────────────────
# Get these from: https://supabase.com → Your Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here


# ── JWT Secrets (Bihanga) ─────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# Run it TWICE — one for each secret. Never share these.
JWT_ACCESS_SECRET=your-access-token-secret-here
JWT_REFRESH_SECRET=your-refresh-token-secret-here


# ── JWT Expiry (Bihanga) ──────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7


# ── bcrypt (Bihanga) ──────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── NIC Privacy (Bihanga) ─────────────────────────────────────────────────────
# Secret key for HMAC-SHA256 NIC hashing
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
NIC_HMAC_SECRET=your-nic-hmac-secret-here

# ── Medical Attachment Metadata Encryption (Bihanga) ─────────────────────────
# AES-256 key for encrypting sensitive file metadata
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be exactly 32 bytes (64 hex chars) for AES-256
METADATA_ENCRYPTION_KEY=your-32-byte-hex-key-here

# ── Gemini AI API (Chethiya / IT-6) ──────────────────────────────────────────
# Primary key
GEMINI_API_KEY=your-primary-gemini-api-key-here
# Optional backup key used automatically if the primary key hits quota/errors
GEMINI_API_KEY_BACKUP=your-backup-gemini-api-key-here
# Optional: comma-separated pool instead of individual backup vars
# GEMINI_API_KEYS=key-one,key-two,key-three
# Optional model override
GEMINI_MODEL=gemini-3-flash-preview


# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=True
